# Linux service for the command-line build (cargo build --release --bin ipswatch-cli).
[Unit]
Description=ipswatch - OPNsense IPS monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ipswatch
WorkingDirectory=/opt/ipswatch
ExecStart=/opt/ipswatch/ipswatch-cli -c /opt/ipswatch/config.toml run
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/ipswatch
PrivateTmp=true

[Install]
WantedBy=multi-user.target
