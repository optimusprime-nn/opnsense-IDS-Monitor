[Unit]
Description=ipswatch - OPNsense IPS monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ipswatch
WorkingDirectory=/opt/ipswatch
ExecStart=/usr/bin/python3 -m ipswatch -c /opt/ipswatch/config.toml run
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/ipswatch
PrivateTmp=true

[Install]
WantedBy=multi-user.target
